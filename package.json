{
  "name": "super-looi-monorepo",
  "license": "GPL-3.0-only",
  "version": "0.2.0",
  "private": true,
  "description": "Super-LOOI: Clean-slate monorepo for embodied personal AI presence",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "clean": "pnpm --recursive run clean",
    "mobile": "pnpm --filter @super-looi/nsh ios",
    "ios": "pnpm --filter @super-looi/nsh ios"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.0"
    }
  }
}
