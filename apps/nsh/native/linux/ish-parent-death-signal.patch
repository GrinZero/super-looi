+// pids_lock keeps the thread list and recipient alive until send_signal.
+static void send_parent_death_signal(struct task *child, int signal, struct siginfo_ info) {
+    struct task *recipient = NULL, *thread;
+    list_for_each_entry(&child->group->threads, thread, group_links) {
+        if (thread->exiting || thread->zombie || thread->sighand == NULL)
+            continue;
