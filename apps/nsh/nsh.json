{
  "name": "Super LOOI",
  "id": "com.superlooi.app",
  "version": "1.0.0",
  "build": 1,
  "rust": ".",
  "capabilities": {
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    },
    "network": {
      "http": [
        {
          "host": "*",
          "schemes": [
            "https"
          ],
          "methods": [
            "GET",
            "POST"
          ]
        }
      ]
    }
  },
  "theme": "theme.json",
  "appearance": "dark"
}
