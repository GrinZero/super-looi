{
  "name": "Super LOOI",
  "id": "com.superlooi.app",
  "version": "1.0.0",
  "build": 1,
  "rust": ".",
  "capabilities": {
    "clipboard": true,
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    },
    "network": {
      "http": [
        {
          "host": "*",
          "schemes": [
            "https"
          ],
          "methods": [
            "GET",
            "POST"
          ]
        }
      ]
    },
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "speech": true
  },
  "theme": "theme.json",
  "appearance": "system"
}
