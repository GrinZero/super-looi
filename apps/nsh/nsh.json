{
  "name": "Super LOOI",
  "id": "com.superlooi.app",
  "icon": "../../assets/brand/super-looi-app-icon.png",
  "version": "1.0.0",
  "build": 1,
  "rust": ".",
  "capabilities": {
    "statusBar": true,
    "clipboard": true,
    "fs": {
      "read": [
        "${dataDir}"
      ],
      "write": [
        "${dataDir}"
      ]
    },
    "network": {
      "http": [
        {
          "host": "*",
          "schemes": [
            "https"
          ],
          "methods": [
            "GET",
            "POST"
          ]
        },
        {
          "host": "localhost",
          "schemes": [
            "http"
          ],
          "port": 3000,
          "methods": [
            "POST"
          ]
        }
      ]
    },
    "openUrl": {
      "schemes": [
        "https"
      ]
    },
    "speech": true
  },
  "theme": "theme.json",
  "appearance": "system",
  "locales": ["zh-CN"],
  "statusBar": {
    "hidden": true
  }
}
