+#[test]
+fn ios_dev_client_stops_after_three_accepted_connections() {
+    use std::net::TcpListener;
+    use tungstenite::protocol::{CloseFrame, frame::coding::CloseCode};
+
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let url = format!("ws://{}{WS_PATH}", listener.local_addr().unwrap());
+    let server = std::thread::spawn(move || {
+        for _ in 0..3 {
+            let (stream, _) = listener.accept().unwrap();
+            let mut socket = tungstenite::accept(stream).unwrap();
+            socket.read().unwrap();
+            socket
+                .close(Some(CloseFrame {
+                    code: CloseCode::Error,
+                    reason: "bundle transfer failed".into(),
+                }))
+                .unwrap();
+        }
+    });
+    let (tx, rx) = mpsc::channel();
+    let _client = DevClient::start(
+        url,
+        HostInfo {
+            platform: HostPlatform::IosSimulator,
+            ..host("test-ios", "bc-1")
+        },
+        move |event| {
+            let _ = tx.send(event);
+        },
+    )
+    .unwrap();
+    for will_retry in [true, true, false] {
+        assert!(matches!(
+            rx.recv_timeout(TIMEOUT).unwrap(),
+            DevEvent::Connected
+        ));
+        assert!(matches!(rx.recv_timeout(TIMEOUT).unwrap(),
+            DevEvent::Disconnected { reason, retrying }
+                if retrying == will_retry && reason.contains("bundle transfer failed")));
+    }
+    assert!(matches!(
+        rx.recv_timeout(TIMEOUT),
+        Err(mpsc::RecvTimeoutError::Disconnected)
+    ));
+    server.join().unwrap();
+}
+
+#[test]
+fn ios_dev_client_stops_on_oversize_frame() {
+    let server = DevServer::start("127.0.0.1:0".parse().unwrap(), "bc-1", None, |_| {}).unwrap();
+    server.publish(
+        vec![1, 2, 3],
+        "source".into(),
+        Some(" ".repeat((16 << 20) + 1)),
+        AppInfo::default(),
+        None,
+        Vec::new(),
+    );
+    let (tx, rx) = mpsc::channel();
+    let _client = DevClient::start(
+        format!("ws://{}{WS_PATH}", server.local_addr()),
+        HostInfo {
+            platform: HostPlatform::IosSimulator,
+            ..host("test-ios", "bc-1")
+        },
+        move |event| {
+            let _ = tx.send(event);
+        },
+    )
+    .unwrap();
+    assert!(matches!(
+        rx.recv_timeout(TIMEOUT).unwrap(),
+        DevEvent::Connected
+    ));
+    assert!(matches!(rx.recv_timeout(TIMEOUT).unwrap(),
+        DevEvent::Disconnected { reason, retrying: false }
+            if reason.contains("read WebSocket") && reason.contains("16777217")));
+    assert!(matches!(
+        rx.recv_timeout(TIMEOUT),
+        Err(mpsc::RecvTimeoutError::Disconnected)
+    ));
+}
+
+#[test]
+fn ios_dev_client_reports_the_loopback_connect_error() {
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let addr = listener.local_addr().unwrap();
+    drop(listener);
+    let original = std::net::TcpStream::connect(addr).unwrap_err();
+    assert_eq!(original.kind(), std::io::ErrorKind::ConnectionRefused);
+    let (tx, rx) = mpsc::channel();
+    let _client = DevClient::start(
+        format!("ws://{addr}{WS_PATH}"),
+        HostInfo {
+            platform: HostPlatform::IosSimulator,
+            ..host("test-ios", "bc-1")
+        },
+        move |event| {
+            let _ = tx.send(event);
+        },
+    )
+    .unwrap();
+    assert!(matches!(rx.recv_timeout(TIMEOUT).unwrap(),
+        DevEvent::Disconnected { reason, retrying: false }
+            if reason.contains("connect WebSocket") && reason.contains(&original.to_string())));
+    assert!(matches!(
+        rx.recv_timeout(TIMEOUT),
+        Err(mpsc::RecvTimeoutError::Disconnected)
+    ));
+}
