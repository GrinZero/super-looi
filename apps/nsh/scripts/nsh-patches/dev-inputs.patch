+// The native dev client uses tungstenite's 16 MiB incoming frame limit.
+pub(crate) fn compact_dev_source_map(map: Option<String>) -> anyhow::Result<Option<String>> {
+    const MAX_FRAME_BYTES: usize = 16 << 20;
+
+    let Some(map) = map else { return Ok(None) };
+    if map.len() <= MAX_FRAME_BYTES {
+        return Ok(Some(map));
+    }
+    let mut map: serde_json::Map<String, serde_json::Value> = serde_json::from_str(&map)?;
+    // Stack symbolication uses positions and source names, without embedded source text.
+    map.remove("sourcesContent");
+    let map = serde_json::to_string(&map)?;
+    anyhow::ensure!(
+        map.len() <= MAX_FRAME_BYTES,
+        "source map frame is {} bytes after removing embedded source text (limit: {MAX_FRAME_BYTES})",
+        map.len(),
+    );
+    Ok(Some(map))
+}
