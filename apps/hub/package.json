{
  "name": "@super-looi/hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/**/*.test.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "verify:dsh": "tsx scripts/verify-dsh.ts",
    "verify:local-center": "tsx scripts/verify-local-center.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@super-looi/contracts": "workspace:*",
    "@super-looi/looi-driver": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "^8.18.0",
    "@super-looi/home-assistant": "workspace:*",
    "@super-looi/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
