LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LOOI_DEBUG_TELEMETRY=0
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
VOICE_PROVIDER=doubao
VOICE_BASE_URL=
VOICE_MODEL=
# Official DSH runtime; Node >=24.9.0. Keep workspace separate from Hub secrets.
DSH_WORKSPACE_ROOT=./data/agent-workspace
DSH_STATE_DIRECTORY=./data/dsh
# Demo tasks are opt-in and never evidence of real execution.
SEED_DEMO=0
# Home Assistant + official Xiaomi Home integration. Credentials stay in Hub.
HA_URL=http://localhost:8123
HA_TOKEN=
HA_INTEGRATION=xiaomi_home
# Comma-separated entity IDs; * enables all supported light/fan/switch/sensor entities.
HA_ALLOWED_ENTITIES=*
EMBEDDING_MODEL=text-embedding-3-small

MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

DATABASE_URL=postgresql://looi:superlooi123!@localhost:5432/looi
VISION_SERVER_URL=http://localhost:8082
VISION_ENABLED=true

PORT=8080
HOST=0.0.0.0

EXPO_PUBLIC_LOOI_SERVER_URL=http://192.168.3.71:8080
EXPO_PUBLIC_SHERPA_STT_MODEL_DIR=sherpa-onnx/asr/sensevoice
EXPO_PUBLIC_SHERPA_STT_MODEL_FILE=model.int8.onnx
EXPO_PUBLIC_SHERPA_STT_TOKENS_FILE=tokens.txt
EXPO_PUBLIC_SHERPA_STT_LANGUAGE=zh
EXPO_PUBLIC_SHERPA_KWS_MODEL_DIR=sherpa-onnx/kws/looi
EXPO_PUBLIC_SHERPA_KEYWORDS_FILE=keywords.txt
EXPO_PUBLIC_SHERPA_KWS_MODEL_TYPE=zipformer2
EXPO_PUBLIC_SHERPA_SPEAKER_MODEL_DIR=sherpa-onnx/speaker-id/looi
EXPO_PUBLIC_SHERPA_SPEAKER_MODEL_FILE=model.onnx
EXPO_PUBLIC_SHERPA_NUM_THREADS=2
