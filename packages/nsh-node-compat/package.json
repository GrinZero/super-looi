{
  "name": "@super-looi/nsh-node-compat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./bundler": "./dist/bundler.js",
    "./shims/*": "./dist/shims/*.js",
    "./pi-coding-bundler": "./dist/pi-coding-bundler.js",
    "./adapters/pi-durable-env": "./dist/adapters/pi-durable-env.js",
    "./adapters/chord-sqlite": "./dist/adapters/chord-sqlite.js",
    "./adapters/codemode": "./dist/adapters/codemode.js",
    "./codemode-bundler": "./dist/codemode-bundler.js",
    "./pi-sdk-bundler": "./dist/pi-sdk-bundler.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx scripts/verify.ts",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "verify:live": "node --env-file=../../.env --import tsx scripts/verify.ts --live",
    "clean": "rm -rf dist",
    "verify:full-sdk": "node --import tsx scripts/audit.ts --sdk && node --import tsx scripts/verify.ts pi-sdk",
    "audit:transparent-sdk": "node --import tsx scripts/audit.ts",
    "verify:codemode": "node --import tsx scripts/verify.ts codemode",
    "test:budgets": "node --import tsx scripts/verify.ts budgets"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.13.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0"
  },
  "peerDependencies": {
    "esbuild": "0.28.2",
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
